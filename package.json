{
  "name": "hangarmc-js",
  "version": "1.0.5",
  "description": "A framework-agnostic fully typed JavaScript client for the Hangar API by PaperMC",
  "homepage": "https://hangarmc-js.creeperkatze.dev",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "docs:api": "typedoc --options typedoc.json",
    "docs:dev": "concurrently -n typedoc,vitepress -c yellow,cyan \"typedoc --options typedoc.json --watch\" \"vitepress dev docs\"",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release:patch": "pnpm version patch && git push && git push --tags",
    "release:minor": "pnpm version minor && git push && git push --tags",
    "release:major": "pnpm version major && git push && git push --tags"
  },
  "keywords": [
    "hangar",
    "papermc",
    "minecraft",
    "plugins",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/creeperkatze/hangarmc-js"
  },
  "bugs": {
    "url": "https://github.com/creeperkatze/hangarmc-js/issues"
  },
  "author": "Creeperkatze",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/vue": "^1.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite-svg-loader": "^5.1.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  }
}
